# Copy this file to ".env" and put your real keys in
ETHERSCAN_API_KEY=your_key_here

# --- Optional: Component 5, AI contract analysis (python analyze_cli.py, and the prompt at the end of main.py) ---
# Keys are read on the server only and are never sent to the model or returned to a frontend.
# Set ONE of these. If both are set, Gemini is used unless LLM_PROVIDER says otherwise.
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_PROVIDER=gemini            # or: groq
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b   # llama-3.3-70b-versatile was retired by Groq on 2026-08-16
# LLM_TIMEOUT_MS=60000
# LLM_MAX_OUTPUT_TOKENS=8192
# LLM_MAX_ATTEMPTS=2
# LLM_MAX_RETRY_WAIT_MS=8000
# LLM_MAX_PROMPT_CHARS=150000   # total prompt budget (system + findings + source). Groq's free tier has small per-minute
#                               # token limits: try ~24000 there. Source that does not fit is truncated/omitted and reported.
